---
layout: base.njk
title: Observations
portrait_left: marcus-aurelius.jpg
portrait_left_alt: Marcus Aurelius
portrait_right: epictetus.jpg
portrait_right_alt: Epictetus
---
<section class="hero">
<h1>Observations</h1>
</section>

<div class="post-list">
{% for post in collections.posts %}
<article class="post-card observation-card">
<p class="post-date">{{ post.date | readableDate }}</p>
<p class="observation-text">{{ (post.data.excerpt or post.templateContent) | safe }}</p>
<a class="read-more" href="{{ post.url }}">Read more &rarr;</a>
</article>
{% endfor %}
</div>
