---
layout: base.njk
title: Observations
pagination:
  data: collections.posts
  size: 10
  alias: pagePosts
---
<section class="hero">
  <h1>Observations</h1>
  <p class="lede">Stoic reflections on ordinary Manchester life — the weather, the streets, the small daily tests of temperament.</p>
</section>

<div class="post-list">
  {% for post in pagePosts %}
  <article class="post-card">
    <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
    <p class="post-meta">{{ post.date | readableDate }}</p>
    <p>{{ post.data.excerpt }}</p>
    <a class="read-more" href="{{ post.url }}">Read more &rarr;</a>
  </article>
  {% endfor %}
</div>
