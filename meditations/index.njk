---
layout: base.njk
title: Meditations
permalink: /meditations/
eleventyExcludeFromCollections: true
---
<section class="hero">
  <h1>Meditations</h1>
  <p class="lede">Slower, longer pieces — reflections that took more than a walk to work out.</p>
</section>

<div class="post-list">
  {% for post in collections.meditations %}
  <article class="post-card">
    <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
    <p class="post-meta">{{ post.date | readableDate }}</p>
    <p>{{ post.data.excerpt }}</p>
    <a class="read-more" href="{{ post.url }}">Read more &rarr;</a>
  </article>
  {% endfor %}
</div>
