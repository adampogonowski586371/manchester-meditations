---
layout: base.njk
title: Meditations
eleventyExcludeFromCollections: true
portrait_left: zeno.jpg
portrait_left_alt: Zeno of Citium
portrait_right: seneca.jpg
portrait_right_alt: Seneca
---
<section class="hero">
<h1>Meditations</h1>
</section>

<div class="post-list">
{% for post in collections.meditations %}
<article class="post-card meditation-card">
<h2 class="meditation-title"><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
<p class="post-date">{{ post.date | readableDate }}</p>
<p>{{ (post.data.excerpt or post.templateContent) | safe }}</p>
<a class="read-more" href="{{ post.url }}">Read more &rarr;</a>
</article>
{% endfor %}
</div>
