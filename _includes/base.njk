<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if title %}{{ title }} — Manchester Meditations{% else %}Manchester Meditations{% endif %}</title>
  <meta name="description" content="A Stoic journal from Manchester — Stoic observations and meditations on ordinary life through an ancient lens. Manchester Stoic reflections, one day at a time.">
  <meta name="keywords" content="Stoic, Stoic journal, Stoic meditations, Manchester Stoic, Stoic Manchester, Stoic observations, Stoic Quotes">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="site-header" id="site-header">
    <div class="header-inner">
      {% if portrait_left %}
      <img class="portrait portrait-left" src="/img/{{ portrait_left }}" alt="{{ portrait_left_alt }}">
      {% endif %}

      <div class="title-block">
        <a href="/" class="site-title-group">
          <span class="site-title">Manchester Meditations</span>
          <span class="site-tagline">A Stoic's Thoughts from Manchester</span>
        </a>
        <nav class="site-nav">
          <a href="/" {% if page.url == "/" %}class="active"{% endif %}>Observations</a>
          <a href="/meditations/" {% if page.url == "/meditations/" %}class="active"{% endif %}>Meditations</a>
          <a href="/about/" {% if page.url == "/about/" %}class="active"{% endif %}>About</a>
        </nav>
      </div>

      {% if portrait_right %}
      <img class="portrait portrait-right" src="/img/{{ portrait_right }}" alt="{{ portrait_right_alt }}">
      {% endif %}
    </div>
  </header>

  <main class="site-main">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <p>&copy; {{ site.year }} Manchester Meditations.</p>
  </footer>

  <script>
    const header = document.getElementById('site-header');
    let lastScroll = 0;
    window.addEventListener('scroll', () => {
      const y = window.scrollY;
      if (y > 40) {
        header.classList.add('shrink');
      } else {
        header.classList.remove('shrink');
      }
      lastScroll = y;
    }, { passive: true });
  </script>
</body>
</html>
